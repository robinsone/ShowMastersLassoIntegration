# Copy this file to .env and fill in your values.
# Do NOT commit .env to source control.

# Your Lasso API key (passed as LASSO-APIKEY header)
LASSO_API_KEY=your_api_key_here

# Base URL for the Lasso API (no trailing slash)
LASSO_BASE_URL=https://test1.lasso.io

# The Lasso Division ID that all imported events will be assigned to
DIVISION_ID=1
