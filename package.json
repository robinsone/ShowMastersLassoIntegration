{
  "name": "showmasters-lasso-ui",
  "version": "0.1.3",
  "private": true,
  "main": "electron/dist/main.cjs",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "electron:bundle-main": "esbuild electron/main.cjs --bundle --platform=node --format=cjs --external:electron --outfile=electron/dist/main.cjs",
    "electron:dev": "pnpm electron:bundle-main && concurrently --kill-others-on-fail --success first \"pnpm dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:build": "pnpm build && pnpm electron:bundle-main && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.showmasters.lasso-integration",
    "productName": "ShowMasters Lasso Integration",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "electron/dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".output",
        "to": "nuxt",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://show-masters-lasso-integration.vercel.app/updates/"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/pwa-512x512.png"
    },
    "nsis": {
      "artifactName": "ShowMasters-Lasso-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@nuxt/ui": "^3.3.7",
    "@vite-pwa/nuxt": "^1.1.1",
    "csv-parse": "^5.6.0",
    "nuxt": "^4.4.8",
    "tailwindcss": "^4.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.113",
    "@types/node": "^22.19.21",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^2.2.12",
    "wait-on": "^9.1.0"
  }
}
